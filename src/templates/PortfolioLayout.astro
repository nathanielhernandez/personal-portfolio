---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/index.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Nathaniel Hernandez is a frontend developer and UX designer in Boston, building accessible interfaces and design systems with React and TypeScript.',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Keep in sync with --bg-color in tokens/semantic/colors.css -->
    <meta name="theme-color" content="#0c0c0c" />
    <script is:inline>
      (() => {
        const colors = { light: '#eee', dark: '#0c0c0c' };
        const prefersLight = matchMedia('(prefers-color-scheme: light)');

        function applyTheme() {
          let saved = null;
          try {
            saved = localStorage.getItem('theme');
          } catch {}

          // Ignore anything that isn't a theme we support
          if (saved !== 'light' && saved !== 'dark') saved = null;

          if (saved) document.documentElement.dataset.theme = saved;
          else delete document.documentElement.dataset.theme;

          // Same fallback as tokens/semantic/theme.css: dark unless the OS prefers light
          const theme = saved ?? (prefersLight.matches ? 'light' : 'dark');

          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', colors[theme]);
        }

        // Let ThemeToggle re-apply after it changes the saved preference
        window.applyTheme = applyTheme;

        applyTheme();
        // ClientRouter replaces <html> and the meta tag on navigation, so run again
        document.addEventListener('astro:after-swap', applyTheme);
        // Follow OS light/dark changes while the page is open
        prefersLight.addEventListener('change', applyTheme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nathaniel Hernandez" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    <!-- Link previews (LinkedIn, iMessage, Slack, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nathaniel Hernandez" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />

    <ClientRouter />
  </head>
  <body>
    <Header transition:animate="none" />

    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    margin: 48px 0;
    gap: 48px;
    max-width: var(--container-max-width);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media screen and (max-width: 768px) {
    main {
      margin: 24px 0;
      gap: 24px;
    }
  }
</style>
