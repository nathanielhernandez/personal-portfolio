---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/index.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Keep in sync with --bg-color in tokens/colors.css -->
    <meta name="theme-color" content="#0c0c0c" />
    <script is:inline>
      (() => {
        const colors = { light: '#eee', dark: '#0c0c0c' };
        const prefersLight = matchMedia('(prefers-color-scheme: light)');

        function applyTheme() {
          let saved = null;
          try {
            saved = localStorage.getItem('theme');
          } catch {}

          // Ignore anything that isn't a theme we support
          if (saved !== 'light' && saved !== 'dark') saved = null;

          if (saved) document.documentElement.dataset.theme = saved;
          else delete document.documentElement.dataset.theme;

          // Same fallback as colors.css: dark unless the OS prefers light
          const theme = saved ?? (prefersLight.matches ? 'light' : 'dark');

          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', colors[theme]);
        }

        // Let ThemeToggle re-apply after it changes the saved preference
        window.applyTheme = applyTheme;

        applyTheme();
        // ClientRouter replaces <html> and the meta tag on navigation, so run again
        document.addEventListener('astro:after-swap', applyTheme);
        // Follow OS light/dark changes while the page is open
        prefersLight.addEventListener('change', applyTheme);
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <ClientRouter />
  </head>
  <body>
    <Header transition:animate="none" />

    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    margin: 48px 0;
    gap: 48px;
    max-width: 768px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  @media screen and (max-width: 768px) {
    main {
      margin: 24px 0;
      gap: 24px;
    }
  }
</style>
