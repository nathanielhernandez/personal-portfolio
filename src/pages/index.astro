    headingLevel={1}
  >
    <Paragraph lineHeight="lg">
      I build interfaces for government applications and design systems that
      scale, with React and TypeScript.
    </Paragraph>
    <span>
      <Link href="/contact" linkType="button">
        Get in touch
      </Link>
    </span>
  </Hero>
  <!-- <Section
    title="Things I'm working on"
    endNav={{ href: '/projects', title: 'View all projects' }}
  >
    <ProjectsHome />
  </Section> -->
  <Section title="About" endNav={{ href: '/about', title: 'More about me' }}>
    <AboutHome />
  </Section>
  <!-- <Section title="Now" endNav={{ href: '/now', title: 'View all updates' }}>
    <NowHome />
  </Section> -->
</PortfolioLayout>
