---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../templates/PortfolioLayout.astro';
import Hero from '../../components/Hero.astro';
import Paragraph from '../../components/ui/Paragraph.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';

const labs = (await getCollection('labs')).sort((a, b) => {
  return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
});
---

<PortfolioLayout title="Labs · Nathaniel Hernandez">
  <Hero title="Lab">
    <Paragraph>Small code snippets and experiments.</Paragraph>
    <Section>
      <div class="labGrid">
        {labs.map((lab) => (
          <article class="labContainer">
            <div class="labBackground" />
            <div class="labPreview" />
            <div class="labDetails">
              <Heading level={2} fontStyle="sans" size="sm" class="title">
                <a href={`/lab/${lab.id}`} class="labLink">
                  {lab.data.title}
                </a>
              </Heading>
              <ul class="stack">
                {lab.data.stack.map((s) => (
                  <li class="stackItem">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </Section>
  </Hero>
</PortfolioLayout>

<style>
  .stack {
    display: flex;
    gap: 0.25rem;
  }

  .stackItem {
    text-transform: capitalize;
    font-size: var(--font-size-3xs);
  }

  .labLink {
    text-decoration: none;
    text-transform: capitalize;
  }

  .labLink:visited {
    color: inherit;
  }

  .labGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .labContainer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    padding: 1rem;
  }

  .labContainer:hover > .labBackground,
  .labContainer:has(:focus-visible) > .labBackground {
    clip-path: inset(0 0 0 0);
  }

  .labBackground {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    background-color: var(--card-bg-color);
    clip-path: inset(2rem 0 0 1rem);
    transition: clip-path ease-in-out 0.2s;
    z-index: -1000;
  }

  .labPreview {
    background-color: white;
    width: 100%;
    aspect-ratio: 16/9;
  }

  .labDetails {
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media screen and (max-width: 768px) {
    .labGrid {
      grid-template-columns: 1fr;
    }

    .labBackground {
      clip-path: inset(0 0 0 0);
    }

    .labDetails {
      padding: 0;
    }
  }
</style>
