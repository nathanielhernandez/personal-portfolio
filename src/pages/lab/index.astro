---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PortfolioLayout from '../../templates/PortfolioLayout.astro';
import Hero from '../../components/Hero.astro';
import Paragraph from '../../components/ui/Paragraph.astro';
import Section from '../../components/ui/Section.astro';
import Heading from '../../components/ui/Heading.astro';

// Drafts show up in dev only
const labs = (
  await getCollection('labs', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => {
  return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
});

const previews = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/lab/*/preview-*.png',
  { eager: true },
);

const previewFor = (id: string, scheme: 'light' | 'dark') =>
  previews[`/src/content/lab/${id}/preview-${scheme}.png`]?.default;

const cards = labs.map((lab) => {
  const light = previewFor(lab.id, 'light') ?? previewFor(lab.id, 'dark');
  const dark = previewFor(lab.id, 'dark') ?? light;
  return { lab, light, dark };
});

const imageProps = {
  alt: '',
  widths: [480, 960, 1440, 1920],
  sizes: '(max-width: 768px) 100vw, 50vw',
};
---

<PortfolioLayout title="Labs · Nathaniel Hernandez">
  <Hero title="Lab">
    <Paragraph>Small code snippets and experiments.</Paragraph>
    <Section>
      <div class="labGrid">
        {cards.map(({ lab, light, dark }) => (
          <article class="labContainer">
            <div class="labBackground" />
            {light && dark ? (
              <>
                <Image
                  src={light}
                  {...imageProps}
                  class="labPreview previewLight"
                />
                <Image
                  src={dark}
                  {...imageProps}
                  class="labPreview previewDark"
                />
              </>
            ) : (
              <div class="labPreview" />
            )}
            <div class="labDetails">
              <Heading level={2} fontStyle="sans" size="sm" class="title">
                <a href={`/lab/${lab.id}`} class="labLink">
                  {lab.data.title}
                </a>
              </Heading>
              <span class="srOnly">Built with</span>
              <ul class="stack">
                {lab.data.stack.map((s) => (
                  <li class="stackItem">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </Section>
  </Hero>
</PortfolioLayout>

<style>
  .srOnly {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .stack {
    display: flex;
    gap: 0.25rem;
  }

  .stackItem {
    text-transform: capitalize;
    font-size: var(--font-size-3xs);
  }

  .labLink {
    text-decoration: none;
    text-transform: capitalize;
  }

  .labLink:visited {
    color: inherit;
  }

  .labContainer:hover .labLink {
    text-decoration: none;
  }

  .labLink:focus-visible {
    outline: none;
  }

  .labContainer:has(.labLink:focus-visible) {
    outline: 2px solid var(--focus-ring-color);
    outline-offset: 2px;
  }

  .labGrid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .labContainer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    padding: 1rem;
  }

  .labContainer:hover > .labBackground,
  .labContainer:has(:focus-visible) > .labBackground {
    clip-path: inset(0 0 0 0);
  }

  .labBackground {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    bottom: 0;
    background-color: var(--card-bg-color);
    clip-path: inset(2rem 0 0 1rem);
    z-index: -1000;
  }

  @media (prefers-reduced-motion: no-preference) {
    .labBackground {
      transition: clip-path ease-in-out 0.2s;
    }
  }

  .labPreview {
    background-color: light-dark(#ececec, #2a2a2a);
    border: 1px solid var(--separator-color);
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 16/9;
    display: block;
    height: auto;
    object-fit: cover;
  }

  .previewLight {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .previewLight {
      display: block;
    }

    :global(:root:not([data-theme])) .previewDark {
      display: none;
    }
  }

  :global(:root[data-theme='light']) .previewLight {
    display: block;
  }

  :global(:root[data-theme='light']) .previewDark {
    display: none;
  }

  .labDetails {
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .labLink::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  @media screen and (max-width: 768px) {
    .labGrid {
      grid-template-columns: 1fr;
    }

    .labBackground {
      clip-path: inset(0 0 0 0);
    }

    .labDetails {
      padding: 0;
    }
  }
</style>
