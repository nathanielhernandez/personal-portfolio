---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../../templates/PortfolioLayout.astro';
import Hero from '../../../components/Hero.astro';
import Section from '../../../components/ui/Section.astro';
import { Code } from 'astro:components';

export async function getStaticPaths() {
  const labs = await getCollection('labs');

  const sources = import.meta.glob<string>('/src/lab/*/*.{tsx,css}', {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  return labs.map((lab) => {
    const folder = `/src/lab/${lab.id}/`;
    const files = Object.entries(sources)
      .filter(([path]) => path.startsWith(folder))
      .map(([path, code]) => ({
        name: path.slice(folder.length),
        lang: path.endsWith('.css') ? 'css' : 'tsx',
        code,
      }));

    return { params: { slug: lab.id }, props: { lab, files } };
  });
}

const { slug } = Astro.params;
const { lab, files } = Astro.props;
---

<PortfolioLayout title=`${lab.data.title} · Nathaniel Hernandez`>
  <Hero title=`${lab.data.title}`>
    <div>{lab.data.description}</div>
  </Hero>
  <Section>
    <iframe
      src={`/lab/${slug}/frame`}
      sandbox="allow-scripts allow-same-origin"
      class="frame"
      title={`${lab.data.title} demo`}
    />
    <p>
      <a href={`/lab/${slug}/frame`} target="_blank" rel="noopener">
        Open demo in a new tab
      </a>
    </p>
  </Section>
</PortfolioLayout>

<style>
  iframe {
    height: 400px;
    border: 1px solid var(--separator-color);
  }
</style>
