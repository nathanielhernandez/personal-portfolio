---
import { getCollection } from 'astro:content';

interface LabMeta {
  title: string;
  description: string;
  draft?: boolean;
}

export async function getStaticPaths() {
  const labs = await getCollection('labs');

  console.log(labs);
  const metas = import.meta.glob<{ meta: LabMeta }>('/src/lab/*/meta.ts', {
    eager: true,
  });

  const sources = import.meta.glob<string>('/src//lab/*/*.{tsx,css}', {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  console.log(metas);

  console.log(sources);

  return Object.entries(metas).map(([path, { meta }]) => {
    const folder = path.replace('meta.ts', '');
    const slug = folder.split('/').at(-2);

    const files = Object.entries(sources).map(([path, code]) => ({
      name: path.slice(folder.length),
      lang: path.endsWith('.css') ? 'css' : 'tsx',
      code,
    }));

    console.log(files);
    return { params: { slug }, props: { meta, files } };
  });
}

const { slug } = Astro.params;
const { meta, files } = Astro.props;
---

<div>{meta.title}</div>

<iframe
  src="/lab/lab-test/frame"
  sandbox="allow-scripts allow-same-origin"
  width="300"
  height="200"
  title="Example Page"
  transfo
></iframe>
