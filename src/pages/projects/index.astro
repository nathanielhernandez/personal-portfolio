---
import { getCollection } from 'astro:content';

import PortfolioLayout from '../../templates/PortfolioLayout.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/ui/Section.astro';
import Paragraph from '../../components/ui/Paragraph.astro';

const allProjects = (await getCollection('projects')).sort((a, b) => {
  return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
});
---

<PortfolioLayout title="Projects · Nathaniel Hernandez">
  <Hero title="Projects">
    <Paragraph>A curation of things I've tinkered with.</Paragraph>
  </Hero>

  <Section>
    <Paragraph size="xs">Projects are coming soon!</Paragraph>
  </Section>
</PortfolioLayout>

<style>
  .blur {
    filter: blur(16px);
  }
</style>
