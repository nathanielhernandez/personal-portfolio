---
import Hero from '../components/Hero.astro';
import Paragraph from '../components/ui/Paragraph.astro';
import PortfolioLayout from '../templates/PortfolioLayout.astro';
import Section from '../components/ui/Section.astro';
import Experience from '../components/Experience.astro';
import Heading from '../components/ui/Heading.astro';

const development = [
  'HTML',
  'CSS',
  'JavaScript',
  'TypeScript',
  'React',
  'Node.js',
  'Tailwind',
  'Express',
  'Astro',
  'Git',
  'Storybook',
];
const design = ['Prototyping', 'Figma', 'Adobe'];
---

<PortfolioLayout title="Resume · Nathaniel Hernandez">
  <Hero title="Resume" headingLevel={1}>
    <Paragraph>My professional work.</Paragraph>
  </Hero>
  <Section>
    <div class="resumeContainer">
      <div class="experienceContainer">
        <Experience />
      </div>
      <div class="skillsContainer">
        <Heading level={2} size="lg">
          Skills
        </Heading>
        <div class="skills">
          <Heading level={3} size="sm">
            Development
          </Heading>
          {development.join(', ')}
        </div>
        <div class="skills">
          <Heading level={3} size="sm">
            Design
          </Heading>
          {design.join(', ')}
        </div>
      </div>
    </div>
  </Section>
</PortfolioLayout>

<style>
  .resumeContainer {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .experienceContainer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .skillsContainer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skills {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contractorBadge {
    font-family: var(--font-family-sans);
    color: var(--paragraph-color);
    font-size: var(--font-size-xxs);
    display: inline-flex;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--paragraph-color);
  }

  @media screen and (max-width: 768px) {
    .resumeContainer {
      flex-direction: column;
    }
  }
</style>
