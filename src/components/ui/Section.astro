---
import Heading from './Heading.astro';
import Link from '../ui/Link.astro';

type EndNav = {
  title: string;
  href: string;
  linkType?: 'internal' | 'external' | 'footer';
};

interface Props {
  title?: string;
  headingLevel?: 1 | 2 | 3 | 4 | 5 | 6;
  endNav?: EndNav;
}

const { title, headingLevel, endNav } = Astro.props;
---

<section>
  {title && (
    <Heading level={headingLevel} size="lg">
      {title}
    </Heading>
  )}
  <slot />
  {endNav && (
    <div class="endNav">
      <Link
        href={endNav.href}
        linkType={endNav.linkType ?? 'internal'}
        class="alignment"
      >
        {endNav.title}
      </Link>
    </div>
  )}
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: 48px;
    border-top: 1px solid var(--separator-color);
  }

  .endNav {
    display: flex;
    justify-content: flex-end;
  }

  @media screen and (max-width: 768px) {
    section {
      padding-top: 24px;
    }

    .endNav {
      justify-content: flex-start;
    }
  }
</style>
