---
import { type HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'p'> {
  lineHeight?: 'md' | 'lg';
  size?: 'md' | 'sm';
}

const { lineHeight = 'md', size = 'sm', class: className } = Astro.props;
---

<p
  class:list={[
    lineHeight == 'md' ? 'lineHeightMd' : 'lineHeightLg',
    size == 'sm' ? 'textSizeSm' : 'textSizeMd',
  ]}
>
  <slot />
</p>

<style>
  p {
    margin: 0;
  }

  .lineHeightMd {
    line-height: var(--line-height-md);
  }

  .lineHeightLg {
    line-height: var(--line-height-lg);
  }

  .textSizeSm {
    font-size: var(--font-size-sm);
  }

  .textSizeMd {
    font-size: var(--font-size-md);
  }
</style>
