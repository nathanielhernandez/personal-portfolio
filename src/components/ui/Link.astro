---
import { type HTMLAttributes } from 'astro/types';
import {
  IconExternalLinkFilled,
  IconChevronRightFilled,
} from '@tabler/icons-astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  linkType?: 'internal' | 'external' | 'footer' | 'button';
}

const { href, linkType, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={[linkType, className]} {...rest}>
  <slot />
  {linkType === 'external' && (
    <IconExternalLinkFilled size={'1em'} aria-hidden="true" />
  )}
  {linkType === 'internal' && (
    <IconChevronRightFilled size={'1em'} aria-hidden="true" />
  )}
</a>

<style>
  a {
    color: var(--accent-color);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--font-size-sm);
    font-family: var(--font-family-sans);
    transition: color 150ms ease;
  }

  a:hover {
    color: var(--button-primary-bg-hover-color);
  }

  a:active {
    color: var(--button-primary-bg-active-color);
  }

  a.button {
    border: 1px solid transparent;
    background-color: var(--button-primary-bg-color);
    color: var(--button-primary-text-color);
    height: 48px;
    min-width: 6rem;
    padding: 0 1rem;
    font-family: var(--font-family-sans);
    font-size: var(--font-size-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  a.button:enabled:hover {
    background-color: var(--button-primary-bg-hover-color);
  }

  a.button:enabled:active {
    background-color: var(--button-primary-bg-active-color);
  }

  a.footer {
    color: var(--paragraph-color);
  }

  a.footer:hover {
    color: var(--heading-color);
  }
</style>
