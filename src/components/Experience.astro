---
import { undefined } from 'astro:schema';
import Heading from './ui/Heading.astro';
const experience = [
  {
    client: 'Social Security Administration',
    location: 'Remote',
    isContract: true,
    startYear: '2022',
    endYear: 'Present',
    roles: [
      {
        title: 'Frontend Developer',
        employer: 'TAYS Inc.',
        startYear: 2026,
        endYear: 'Present',
      },
      {
        title: 'Senior UX Designer',
        employer: 'Sky Tech Services',
        startYear: 2025,
        endYear: 2026,
      },
      {
        title: 'UI Technical Designer',
        employer: 'Sky Solutions',
        startYear: 2022,
        endYear: 2025,
      },
    ],
    responsibilities: [
      'Built reusable TypeScript React components for Pega Constellation DX, meeting WCAG and Section 508 accessibility standards.',
      'Designed high-fidelity prototypes for Pega case management workflows, validating UX with stakeholders before development.',
      'Documented the component library in Storybook, creating a single source of truth for design and engineering teams.',
      'Partnered with product owners and developers to translate business requirements into accessible UI specifications and patterns.',
      'Served as a resource for developers on frontend and UX issues, resolving technical and design blockers to keep sprints on schedule.',
    ],
  },
  {
    client: 'Coforge',
    location: 'Boise, ID',
    isContract: false,
    startYear: '2019',
    endYear: '2022',
    roles: [
      {
        title: 'Pega System Architect',
        employer: '',
        startYear: '',
        endYear: '',
      },
    ],
    responsibilities: [
      'Developed business process management (BPM) web applications on the Pega Platform, designing case lifecycles, building case flows, and implementing the UI for enterprise clients.',
      'Created and integrated design systems across Pega web applications, establishing consistent, reusable UI patterns.',
      'Led requirements sessions with enterprise clients, translating business needs into technical designs and working Pega application features.',
    ],
  },
];
---

<Heading level={2} size="lg">
  Experience
</Heading>

<ul class="experienceList">
  {experience.map((exp) => (
    <li class="expDetails">
      <div class="expTitle">
        <span class="dates">
          {exp.startYear} — {exp.endYear}
        </span>
        <span class="client">{exp.client}</span>
        <span class="clientDetails">
          {exp.isContract && 'Contractor •'} {exp.location}
        </span>
      </div>
      <ul class="roleList">
        {exp.roles.map((r) => (
          <li class="role">
            <div class="roleDetails">
              <span class="roleTitle">{r.title}</span>
              {r.employer && <span class="roleEmployer">via {r.employer}</span>}
            </div>
            {r.startYear && r.endYear && (
              <span class="roleYears">
                {r.startYear} — {r.endYear}
              </span>
            )}
          </li>
        ))}
      </ul>
      <ul class="responsibilitiesList">
        {exp.responsibilities.map((r) => (
          <li class="responsibility">{r}</li>
        ))}
      </ul>
    </li>
  ))}
</ul>

<style>
  .experienceList {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .expDetails {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .expTitle {
    display: flex;
    flex-direction: column;
  }

  .dates {
    font-size: var(--font-size-xs);
  }

  .client {
    color: var(--heading-color);
    font-size: var(--font-size-md);
  }

  .roleList {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .role {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
  }

  .roleDetails {
    display: flex;
    flex-direction: column;
  }

  .roleTitle {
    color: var(--heading-color);
  }

  .roleEmployer {
    font-size: var(--font-size-xxs);
  }

  ul.responsibilitiesList {
    list-style-type: square;
    margin-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  ::marker {
    color: var(--accent-color);
  }
</style>
